# ============================================================
# Effi Processor - Variables de entorno
# ============================================================
#
# IMPORTANTE:
# Las variables siguientes son una PROPUESTA DE CONFIGURACIÓN.
# No deben considerarse funcionales hasta confirmar que
# app_effi.py / src/effi_processor las leen explícitamente.
#
# Copiar este archivo como .env solamente si la implementación
# actual requiere variables de entorno.
#
# ============================================================

# Ruta personalizada de Tesseract.
# PENDIENTE DE CONFIRMAR que la aplicación la soporte.
# TESSERACT_CMD=

# Nivel de logging.
# PENDIENTE DE CONFIRMAR que la aplicación lo soporte.
# LOG_LEVEL=INFO

# Directorio de salida.
# PENDIENTE DE CONFIRMAR que la aplicación lo soporte.
# OUTPUT_DIR=salidas

# Umbral de coincidencia.
# PENDIENTE DE CONFIRMAR que la aplicación lo soporte.
# MATCH_THRESHOLD=0.85

# Tasa de IVA.
# PENDIENTE DE CONFIRMAR que la aplicación la soporte.
# IVA_RATE=0.19
