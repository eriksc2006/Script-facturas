# ============================================================
# Effi Processor - Variables de entorno
# ============================================================
#
# Copiar este archivo como .env si necesita personalizar rutas.
# No subir .env al repositorio (contiene secretos locales).
#
# ============================================================

# Ruta personalizada de Tesseract (Windows / Linux / macOS).
# TESSERACT_CMD=

# --- Vision LLM local (Ollama, gratis, sin API cloud) ---
# Daemon local. Las facturas NO se envían a internet.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Modelo vision. Instalar con: ollama pull moondream
OLLAMA_VISION_MODEL=moondream

# Nivel de logging.
# LOG_LEVEL=INFO

# Directorio de salida.
# OUTPUT_DIR=salidas

# Ollama local (gratuito). La aplicación sí lee estas variables.
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
# Si ya tiene otro modelo (p. ej. moondream), indíquelo aquí o elíjalo en la barra lateral.

# Umbral de coincidencia.
# MATCH_THRESHOLD=0.85

# Tasa de IVA.
# IVA_RATE=0.19
